#!/usr/bin/env bash
#
# git-openxet — a Git clean/smudge filter backed by an OpenXet CAS server.
#
# This mirrors how Git LFS (and HuggingFace's Xet) keep large bytes out of git:
# git stores a tiny *pointer file*, and a filter swaps the pointer for the real
# bytes on checkout (smudge) and the real bytes for a pointer on add (clean).
#
#   • clean  (git add):     file bytes on stdin  -> upload to OpenXet -> pointer on stdout
#   • smudge (git checkout): pointer on stdin    -> download from OpenXet -> bytes on stdout
#
# The pointer that lands in git history looks like:
#
#     version https://openxet/spec/v1
#     xet-file-hash <64-hex>
#     size <bytes>
#
# Install into a repo:
#     git-openxet install
#     echo '*.bin filter=openxet -text' >> .gitattributes
#
# Configuration (env):
#     OPENXET_URL   base URL of the CAS server (default http://127.0.0.1:8080)
#
# The /api/* endpoints used here are unauthenticated management endpoints. A
# production integration would drive the authenticated /v1/* Xet wire protocol
# (chunk-dedup query -> xorb upload -> shard register -> reconstruction) and
# mint a JWT; see examples/README.md.
#
# Requirements: bash, curl, python3.
set -euo pipefail

OPENXET_URL="${OPENXET_URL:-http://127.0.0.1:8080}"
POINTER_VERSION="https://openxet/spec/v1"
PART_SIZE=$((32 * 1024 * 1024)) # stay under the 64 MiB single-request body limit

json_str() { python3 -c "import sys,json;print(json.load(sys.stdin)['$1'])"; }

# Upload a file via the multipart session API; echoes the file_hash.
upload_file() { # <path>
  local file="$1" size sid parts_dir idx p
  size="$(wc -c < "$file" | tr -d ' ')"

  sid="$(curl -fsS -X POST "$OPENXET_URL/api/upload/init" \
          -H 'Content-Type: application/json' \
          -d "{\"file_size\": $size}" | json_str session_id)"

  parts_dir="$(mktemp -d)"
  split -b "$PART_SIZE" "$file" "$parts_dir/part."
  idx=0
  for p in "$parts_dir"/part.*; do
    curl -fsS -X PUT "$OPENXET_URL/api/upload/$sid/$idx" \
         -H 'Content-Type: application/octet-stream' \
         --data-binary "@$p" >/dev/null
    idx=$((idx + 1))
  done
  rm -rf "$parts_dir"

  curl -fsS -X POST "$OPENXET_URL/api/upload/$sid/complete" | json_str file_hash
}

cmd_clean() {
  # stdin = real file content. Buffer to a temp file (could be many GiB),
  # upload it, and emit the pointer that git will actually store.
  local tmp hash size
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' RETURN
  cat > "$tmp"
  size="$(wc -c < "$tmp" | tr -d ' ')"
  hash="$(upload_file "$tmp")"
  printf '%s\n' "$POINTER_VERSION"
  printf 'xet-file-hash %s\n' "$hash"
  printf 'size %s\n' "$size"
}

cmd_smudge() {
  # stdin = pointer (or, for non-tracked content, arbitrary bytes). If it is
  # one of our pointers, replace it with the real bytes; otherwise pass through.
  local first rest hash
  IFS= read -r first || true
  if [[ "$first" != "$POINTER_VERSION" ]]; then
    # Not our pointer — emit unchanged and stream the rest.
    [[ -n "${first+x}" ]] && printf '%s\n' "$first"
    cat
    return 0
  fi
  rest="$(cat)"
  hash="$(printf '%s\n' "$rest" | awk '/^xet-file-hash /{print $2}')"
  if [[ -z "$hash" ]]; then
    echo "git-openxet: malformed pointer (no xet-file-hash)" >&2
    exit 1
  fi
  curl -fsS "$OPENXET_URL/api/files/$hash/content"
}

cmd_install() {
  git config filter.openxet.clean  "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/git-openxet clean %f"
  git config filter.openxet.smudge "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/git-openxet smudge %f"
  git config filter.openxet.required true
  echo "Configured filter.openxet in $(git rev-parse --show-toplevel)"
  echo "Now add a pattern to .gitattributes, e.g.:  *.bin filter=openxet -text"
}

case "${1:-}" in
  clean)   shift; cmd_clean "$@" ;;
  smudge)  shift; cmd_smudge "$@" ;;
  install) shift; cmd_install "$@" ;;
  *) echo "usage: git-openxet {clean|smudge|install} [git-passes-%f-here]" >&2; exit 2 ;;
esac
